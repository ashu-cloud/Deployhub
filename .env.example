# DeployHub — Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit .env — it is blocked by .gitignore.
# Run `python scripts/generate_secrets.py` to generate the secret fields.

# ─────────────────────────────────────────────
# Database (Postgres)
# ─────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>:5432/<dbname>

# ─────────────────────────────────────────────
# Cache / Logs (Redis)
# ─────────────────────────────────────────────
REDIS_URL=redis://<host>:6379/0
# For Upstash (TLS): rediss://default:<password>@<host>:6379

# ─────────────────────────────────────────────
# Event Streaming (Kafka)
# For local dev: use kafka:9092 and leave SASL fields blank.
# For Aiven / Confluent Cloud: fill in all SASL fields.
# ─────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=deployhub_kafka:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# ─────────────────────────────────────────────
# Object Storage (MinIO / AWS S3)
# ─────────────────────────────────────────────
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=<minio_access_key>
S3_SECRET_KEY=<minio_secret_key>

# ─────────────────────────────────────────────
# GitHub OAuth App
# Create at: https://github.com/settings/developers → OAuth Apps
# ─────────────────────────────────────────────
GITHUB_CLIENT_ID=<your_github_oauth_client_id>
GITHUB_CLIENT_SECRET=<your_github_oauth_client_secret>

# GitHub Personal Access Token or GitHub App installation token
# Required to register webhooks on user repositories.
GITHUB_API_TOKEN=<your_github_pat_or_app_token>

# ─────────────────────────────────────────────
# AI Diagnosis (Groq)
# Get key at: https://console.groq.com/keys
# Leave empty to disable AI diagnosis.
# ─────────────────────────────────────────────
GROQ_API_KEY=

# ─────────────────────────────────────────────
# Security / Encryption Secrets
# Generate with: python scripts/generate_secrets.py
# ─────────────────────────────────────────────
WEBHOOK_SECRET=<64-char-hex-string>
ENV_VAR_ENCRYPTION_KEY=<64-char-hex-string>
POSTGRES_PASSWORD=<strong-random-password>
MINIO_ROOT_PASSWORD=<strong-random-password>

# ─────────────────────────────────────────────
# Service URLs / CORS
# ─────────────────────────────────────────────
FRONTEND_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3001
GITHUB_REDIRECT_URI=http://localhost:3001/api/v1/auth/callback

# Public URL GitHub webhooks POST to (use ngrok/cloudflare tunnel for local dev)
WEBHOOK_BASE_URL=http://localhost:3001/api/v1

# ─────────────────────────────────────────────
# Caddy API Gateway
# ─────────────────────────────────────────────
CADDY_ADMIN_URL=http://caddy:2019
